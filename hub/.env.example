# Hub configuration. scripts/install-hub.ps1 writes hub/.env with these values.
# lan = option A (campus network / VPN); tunnel = option B (Cloudflare Tunnel + Access)
LOCALVIA_HUB_MODE=lan
LOCALVIA_HUB_HOST=0.0.0.0
LOCALVIA_HUB_PORT=8443
LOCALVIA_HUB_TLS_CERT_FILE=D:/local-via/hub/certs/hub.crt
LOCALVIA_HUB_TLS_KEY_FILE=D:/local-via/hub/certs/hub.key
LOCALVIA_HUB_DATA_DIR=D:/local-via/data/hub
LOCALVIA_HUB_UI_DIR=D:/local-via/out
# Lab subnet: only these addresses (and the hub itself) may act as workers or open the admin panel.
LOCALVIA_HUB_WORKER_NETWORKS=10.20.30.0/24
LOCALVIA_HUB_ADMIN_NETWORKS=10.20.30.0/24
LOCALVIA_HUB_MAX_ACTIVE_JOBS_PER_USER=1
LOCALVIA_HUB_MAX_UPLOAD_MB=200
LOCALVIA_HUB_USER_QUOTA_MB=2048
LOCALVIA_HUB_RETENTION_DAYS=14
LOCALVIA_HUB_SESSION_HOURS=12
LOCALVIA_HUB_LEASE_SECONDS=90
