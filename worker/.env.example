# Lab PC agent. scripts/install-worker.ps1 writes worker/.env with these values.
LOCALVIA_WORKER_HUB_URL=https://aula-pc-01:8443
# Generated on the hub with: python -m hub.cli add-worker <name>  (shown once)
LOCALVIA_WORKER_TOKEN=replace-with-the-token-from-add-worker
# Copy of the hub certificate (hub/certs/hub.crt). Leave empty if the hub uses a certificate trusted by Windows.
LOCALVIA_WORKER_CA_FILE=D:/local-via/worker/certs/hub.crt
LOCALVIA_WORKER_BACKEND=wangp
LOCALVIA_WORKER_DATA_DIR=D:/local-via/data/worker
LOCALVIA_WORKER_WANGP_ROOT=D:/local-via/.runtime/Wan2GP
LOCALVIA_WORKER_WANGP_CLI_ARGS=--attention sdpa --profile 4 --perc-reserved-mem-max 0.25
LOCALVIA_WORKER_WANGP_PRELOAD_MB=4000
# Unload the model after this many idle seconds.
LOCALVIA_WORKER_MODEL_IDLE_TIMEOUT_SECONDS=3600
# Do not take new jobs at or above this GPU temperature (0 disables the guard).
LOCALVIA_WORKER_MAX_GPU_TEMP_C=85
